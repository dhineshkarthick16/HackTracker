# ==============================================================================
# HackTrack Environment Configuration
# ==============================================================================

# Supabase Project URL (from Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: If these values are omitted or left blank, HackTrack automatically runs
# in the client-side isolated multi-user mode with zero external dependencies.
